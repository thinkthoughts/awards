{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "sources.schema.json",
 "title": "Pinned external repositories cited by the survey",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "sources"
 ],
 "properties": {
  "schema": {
   "enum": [
    "survey/sources@1"
   ]
  },
  "description": {
   "type": "string",
   "minLength": 1
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "repository",
     "commit"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
     },
     "repository": {
      "type": "string",
      "minLength": 1
     },
     "url": {
      "type": "string",
      "minLength": 1
     },
     "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
     },
     "ref": {
      "type": "string",
      "minLength": 1
     },
     "toolchain": {
      "type": "string",
      "minLength": 1
     },
     "mathlib": {
      "type": "string",
      "minLength": 1
     },
     "notes": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 }
}
