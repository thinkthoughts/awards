{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "edges.schema.json",
 "title": "Typed PiπΠ lifts and other dependency edges",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "edges"
 ],
 "properties": {
  "schema": {
   "enum": [
    "survey/edges@1"
   ]
  },
  "description": {
   "type": "string",
   "minLength": 1
  },
  "edges": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "from",
     "to",
     "relation",
     "strength",
     "statement",
     "hypotheses",
     "source",
     "state",
     "obligation"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^(LIFT|EDGE)-[A-Za-z0-9.-]+$"
     },
     "from": {
      "type": "string",
      "minLength": 1,
      "description": "A registry id, a catalog id (JSP-nnnnnn), or lean:<source>:<fully qualified name>."
     },
     "to": {
      "type": "string",
      "minLength": 1,
      "description": "A registry id, a catalog id (JSP-nnnnnn), or lean:<source>:<fully qualified name>."
     },
     "relation": {
      "enum": [
       "reading-of",
       "equivalent",
       "implies",
       "special-case",
       "closure",
       "cardinality-equality",
       "supplies-hypothesis",
       "analogy",
       "membership",
       "scope-boundary"
      ]
     },
     "strength": {
      "enum": [
       "direct-application",
       "conditional-implication",
       "structural-analogy",
       "general-distinction",
       "shared-reading",
       "boundary"
      ]
     },
     "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "math"
      ],
      "properties": {
       "math": {
        "type": "string",
        "minLength": 1
       },
       "lean_name": {
        "type": "string",
        "minLength": 1
       },
       "lean": {
        "type": "string",
        "minLength": 1
       },
       "proof_term": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "uses": {
      "type": "array",
      "items": {
       "$ref": "common.schema.json#/$defs/leanRef"
      }
     },
     "hypotheses": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "id",
        "statement",
        "role",
        "status"
       ],
       "properties": {
        "id": {
         "type": "string",
         "minLength": 1
        },
        "statement": {
         "type": "string",
         "minLength": 1
        },
        "lean": {
         "type": "string",
         "minLength": 1
        },
        "role": {
         "enum": [
          "side-condition",
          "assumption"
         ]
        },
        "status": {
         "enum": [
          "discharged",
          "open",
          "open-conjecture"
         ]
        }
       }
      }
     },
     "source": {
      "type": "string",
      "minLength": 1
     },
     "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "mathematical",
       "formalization",
       "verification"
      ],
      "properties": {
       "mathematical": {
        "enum": [
         "established",
         "candidate"
        ]
       },
       "formalization": {
        "enum": [
         "prose",
         "specified",
         "compiled"
        ]
       },
       "verification": {
        "enum": [
         "unverified",
         "upstream-reported",
         "kernel-checked",
         "comparator-nonisolated",
         "comparator-accepted"
        ]
       }
      }
     },
     "obligation": {
      "enum": [
       "open",
       "discharged",
       "recorded"
      ]
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "notes": {
      "type": "string",
      "minLength": 1
     },
     "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "property",
       "carrier",
       "order",
       "direction",
       "transfer",
       "lean"
      ],
      "description": "Relation 'closure' only: the property, the order or operation it is closed under, and the direction of transfer.",
      "properties": {
       "property": {
        "type": "string",
        "minLength": 1
       },
       "carrier": {
        "type": "string",
        "minLength": 1
       },
       "order": {
        "type": "string",
        "minLength": 1
       },
       "direction": {
        "enum": [
         "downward",
         "upward"
        ]
       },
       "transfer": {
        "type": "string",
        "minLength": 1
       },
       "lean": {
        "type": "string",
        "minLength": 1
       },
       "witness": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "lhs",
       "lhs_carrier",
       "rhs",
       "rhs_carrier",
       "map",
       "injectivity",
       "moduli",
       "lean"
      ],
      "description": "Relation 'cardinality-equality' only: the two counted sets, the map carrying one onto the other, why it is injective, and the moduli covered.",
      "properties": {
       "lhs": {
        "type": "string",
        "minLength": 1
       },
       "lhs_carrier": {
        "type": "string",
        "minLength": 1
       },
       "rhs": {
        "type": "string",
        "minLength": 1
       },
       "rhs_carrier": {
        "type": "string",
        "minLength": 1
       },
       "map": {
        "type": "string",
        "minLength": 1
       },
       "injectivity": {
        "type": "string",
        "minLength": 1
       },
       "moduli": {
        "type": "string",
        "minLength": 1
       },
       "lean": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "characterizes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "object",
       "defined_by",
       "criterion",
       "connective",
       "lean"
      ],
      "description": "Relation 'equivalent' only: the object whose definition the equivalence restates, its definition, the equivalent criterion, and the edges it composes.",
      "properties": {
       "object": {
        "type": "string",
        "minLength": 1
       },
       "defined_by": {
        "type": "string",
        "minLength": 1
       },
       "criterion": {
        "type": "string",
        "minLength": 1
       },
       "connective": {
        "type": "string",
        "minLength": 1
       },
       "lean": {
        "type": "string",
        "minLength": 1
       },
       "via": {
        "type": "array",
        "items": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     }
    }
   }
  }
 }
}
