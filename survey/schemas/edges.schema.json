{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "edges.schema.json",
 "title": "Typed PiπΠ lifts and other dependency edges",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "edges"
 ],
 "properties": {
  "schema": {
   "enum": [
    "survey/edges@1"
   ]
  },
  "description": {
   "type": "string",
   "minLength": 1
  },
  "edges": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "from",
     "to",
     "relation",
     "strength",
     "statement",
     "hypotheses",
     "source",
     "state",
     "obligation"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^(LIFT|EDGE)-[A-Za-z0-9.-]+$"
     },
     "from": {
      "type": "string",
      "minLength": 1,
      "description": "A registry id, a catalog id (JSP-nnnnnn), or lean:<source>:<fully qualified name>."
     },
     "to": {
      "type": "string",
      "minLength": 1,
      "description": "A registry id, a catalog id (JSP-nnnnnn), or lean:<source>:<fully qualified name>."
     },
     "relation": {
      "enum": [
       "reading-of",
       "equivalent",
       "implies",
       "special-case",
       "supplies-hypothesis",
       "analogy",
       "membership",
       "scope-boundary"
      ]
     },
     "strength": {
      "enum": [
       "direct-application",
       "conditional-implication",
       "structural-analogy",
       "general-distinction",
       "shared-reading",
       "boundary"
      ]
     },
     "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "math"
      ],
      "properties": {
       "math": {
        "type": "string",
        "minLength": 1
       },
       "lean_name": {
        "type": "string",
        "minLength": 1
       },
       "lean": {
        "type": "string",
        "minLength": 1
       },
       "proof_term": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "uses": {
      "type": "array",
      "items": {
       "$ref": "common.schema.json#/$defs/leanRef"
      }
     },
     "hypotheses": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "id",
        "statement",
        "role",
        "status"
       ],
       "properties": {
        "id": {
         "type": "string",
         "minLength": 1
        },
        "statement": {
         "type": "string",
         "minLength": 1
        },
        "lean": {
         "type": "string",
         "minLength": 1
        },
        "role": {
         "enum": [
          "side-condition",
          "assumption"
         ]
        },
        "status": {
         "enum": [
          "discharged",
          "open",
          "open-conjecture"
         ]
        }
       }
      }
     },
     "source": {
      "type": "string",
      "minLength": 1
     },
     "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "mathematical",
       "formalization",
       "verification"
      ],
      "properties": {
       "mathematical": {
        "enum": [
         "established",
         "candidate"
        ]
       },
       "formalization": {
        "enum": [
         "prose",
         "specified",
         "compiled"
        ]
       },
       "verification": {
        "enum": [
         "unverified",
         "upstream-reported",
         "kernel-checked",
         "comparator-nonisolated",
         "comparator-accepted"
        ]
       }
      }
     },
     "obligation": {
      "enum": [
       "open",
       "discharged",
       "recorded"
      ]
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "notes": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 }
}
