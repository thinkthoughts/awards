{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "readings.schema.json",
 "title": "L2 reading points (JSP entries and foundational readings)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "readings"
 ],
 "properties": {
  "schema": {
   "enum": [
    "survey/readings@1"
   ]
  },
  "description": {
   "type": "string",
   "minLength": 1
  },
  "readings": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "kind",
     "spec",
     "parameters",
     "statement",
     "leading_constraints",
     "excluded_generalizations",
     "state"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^RP-[A-Za-z0-9-]+$"
     },
     "layer": {
      "enum": [
       "L2"
      ]
     },
     "kind": {
      "enum": [
       "foundational",
       "jsp"
      ]
     },
     "jsp": {
      "type": "string",
      "pattern": "^JSP-[0-9]{6}$"
     },
     "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "title",
       "volume",
       "status",
       "lean_proof"
      ],
      "properties": {
       "title": {
        "type": "string",
        "minLength": 1
       },
       "volume": {
        "type": "string",
        "minLength": 1
       },
       "status": {
        "enum": [
         "Open",
         "Solved"
        ]
       },
       "lean_proof": {
        "type": "boolean"
       },
       "text": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "spec": {
      "type": "string",
      "minLength": 1
     },
     "parameters": {
      "type": "object"
     },
     "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "math"
      ],
      "properties": {
       "math": {
        "type": "string",
        "minLength": 1
       },
       "lean_name": {
        "type": "string",
        "minLength": 1
       },
       "lean": {
        "type": "string",
        "minLength": 1
       },
       "proof_term": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "lean": {
      "type": "array",
      "items": {
       "$ref": "common.schema.json#/$defs/leanRef"
      }
     },
     "leading_constraints": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "excluded_generalizations": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "mathematical",
       "formalization",
       "verification"
      ],
      "properties": {
       "mathematical": {
        "enum": [
         "proved",
         "open",
         "refuted",
         "independent"
        ]
       },
       "formalization": {
        "enum": [
         "prose",
         "specified",
         "compiled"
        ]
       },
       "verification": {
        "enum": [
         "unverified",
         "upstream-reported",
         "kernel-checked",
         "comparator-accepted"
        ]
       }
      }
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "notes": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 }
}
