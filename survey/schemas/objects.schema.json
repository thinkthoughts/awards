{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "objects.schema.json",
 "title": "L0 shared mathematical objects",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "objects"
 ],
 "properties": {
  "schema": {
   "enum": [
    "survey/objects@1"
   ]
  },
  "description": {
   "type": "string",
   "minLength": 1
  },
  "objects": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "definition",
     "lean",
     "state"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^OBJ-[A-Za-z0-9-]+$"
     },
     "layer": {
      "enum": [
       "L0"
      ]
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "definition": {
      "type": "string",
      "minLength": 1
     },
     "lean": {
      "type": "array",
      "items": {
       "$ref": "common.schema.json#/$defs/leanRef"
      }
     },
     "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "mathematical",
       "formalization",
       "verification"
      ],
      "properties": {
       "mathematical": {
        "enum": [
         "defined"
        ]
       },
       "formalization": {
        "enum": [
         "prose",
         "specified",
         "compiled"
        ]
       },
       "verification": {
        "enum": [
         "unverified",
         "upstream-reported",
         "kernel-checked",
         "comparator-accepted"
        ]
       }
      }
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "notes": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 }
}
