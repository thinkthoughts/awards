@BGP212.Challenge.gdtH_single_shift : ∀ {N m : ℕ},
  0 < N →
    ∀ (a : ℤ),
      (BGP212.MultiShift.AdmissibleH N m a {0} ↔ GDT.Admissible N m a) ∧
        (∀ (n : ℕ), BGP212.MultiShift.acceptedH N m a {0} n ↔ GDT.accepted N m a n) ∧
          BGP212.MultiShift.localCount N m {0} = (GDT.R N m).totient
@BGP212.Challenge.gdt_count_per_period_via_multishift : ∀ {N m : ℕ},
  0 < N →
    0 < m →
